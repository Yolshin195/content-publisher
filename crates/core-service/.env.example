DATABASE_URL=postgres://postgres:postgres@localhost:5432/core_db

# ── Доступ ──────────────────────────────────────────────────────────────────
# Пароль для входа в веб-интерфейс. ОБЯЗАТЕЛЕН в продакшене.
ADMIN_PASSWORD=change-me
# Токен для REST API и MCP-коннектора Claude (Authorization: Bearer ... или /mcp?token=...).
# Сгенерировать: openssl rand -hex 32
API_TOKEN=
# Секрет подписи cookie-сессии (по умолчанию выводится из ADMIN_PASSWORD;
# смена пароля разлогинивает все сессии).
# SESSION_SECRET=
# Публичный адрес сервиса — для ссылок в ответах Claude; https:// включает Secure-cookie.
PUBLIC_BASE_URL=http://localhost:8080

# Часовой пояс автора: календарь, время в интерфейсе, аналитика (IANA, напр. Europe/Moscow).
APP_TIMEZONE=Asia/Bangkok

SCHEDULER_TICK_INTERVAL_SECONDS=30
PUBLISH_MAX_ATTEMPTS=3

# Реестр Publisher-микросервисов. Без него публикация вернёт понятную ошибку,
# остальной функционал (посты, промпты, календарь) работает.
PUBLISHER_TELEGRAM_URL=http://localhost:8081
# PUBLISHER_VK_URL=http://localhost:8082

# Не обязательно: без Media Service обложку можно указать прямой ссылкой на картинку.
# MEDIA_SERVICE_URL=http://localhost:8090

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=info,core_service=debug,tower_http=info
